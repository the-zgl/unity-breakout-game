<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LogicSmoke</AssemblyName>
    <RootNamespace>Breakout.Tools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      允许在只有更新 Runtime 的机器上运行（例如 CI 里只装了 .NET 8 runtime，
      没有 net6.0 runtime 时，默认会报「找不到框架」）。加上 Major 级 roll-forward 后，
      net6.0 的程序可以跑在 .NET 8 上。
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- 直接引用游戏里的纯 C# 逻辑文件，保证「测试跑的就是游戏用的那份代码」 -->
    <Compile Include="../../Assets/Scripts/GameState.cs" />
    <Compile Include="../../Assets/Scripts/PaymentService.cs" />
  </ItemGroup>

</Project>
